# Root & SPA HTML routes - must revalidate so search engines and visitors always get fresh releases
/
  Cache-Control: public, max-age=0, must-revalidate

/docs
  Cache-Control: public, max-age=0, must-revalidate

/changelog
  Cache-Control: public, max-age=0, must-revalidate

/privacy
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Immutable caching for hashed Vite asset chunks (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font caching (1 year)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Social Card & Favicon caching (30 days)
/og-image.png
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000

# Security and privacy headers across all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
