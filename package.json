{
  "name": "barstile",
  "version": "1.1.0",
  "description": "Self-hosted, non-interactive bot protection",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "import": "./src/server/index.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./src/client/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./src/frameworks/react.js"
    },
    "./web-component": {
      "types": "./types/web-component.d.ts",
      "import": "./src/client/web-component.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gozajpeg/barstile.git"
  },
  "homepage": "https://github.com/gozajpeg/barstile#readme",
  "bugs": {
    "url": "https://github.com/gozajpeg/barstile/issues"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "dev": "npm --prefix website run dev",
    "build:website": "npm --prefix website run build"
  },
  "keywords": [
    "anti-bot",
    "bot-protection",
    "captcha",
    "challenge-response",
    "anti-scraping",
    "proof-of-work",
    "pow",
    "rate-limit",
    "web-security",
    "zero-dependency",
    "sha256"
  ],
  "author": "gozajpeg",
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/gozajpeg"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {}
}